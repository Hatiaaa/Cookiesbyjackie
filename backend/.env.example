PORT=3001

# Orígenes permitidos para CORS (separa varios por coma, sin barra final).
# Incluye el dominio del sitio (subdominio del cliente) Y el hosting del dashboard.
# Ej: https://cookiesbyjackie.com,https://admin.tudominio.com
# Deja '*' solo para desarrollo local.
ALLOWED_ORIGINS=https://cookiesbyjackie.com,https://admin.tudominio.com

# URL pública del SITIO (frontend) — usada para las URLs de retorno de Stripe.
# Sin barra final.
SITE_URL=https://cookiesbyjackie.com

# MySQL/MariaDB (Hostinger)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cookiesbyjackie
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql

# Credenciales del dashboard (admin)
ADMIN_USERNAME=jackie
ADMIN_PASSWORD_HASH=   # genera con: node hash-password.js <tu-password>

# Cadena aleatoria larga (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_una_cadena_muy_larga_y_aleatoria

# ── Stripe ─────────────────────────────────────────────────────────────
# Claves desde https://dashboard.stripe.com/apikeys (usa las de TEST para probar)
STRIPE_SECRET_KEY=sk_test_...
# Secreto del webhook (https://dashboard.stripe.com/webhooks -> tu endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
# Moneda ISO en minúsculas (usd, mxn, eur, ...)
STRIPE_CURRENCY=usd

# Validación de precios contra el catálogo del servidor (catalog.js):
#   strict = rechaza pedidos con precios no reconocidos (recomendado)
#   warn   = solo registra en consola y deja pasar
#   off    = desactiva la validación
PRICE_VALIDATION=strict
